*.vrm.res

# Godot-specific ignores
.import/
.godot/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/

# System/tool-specific ignores
.DS_Store
*~

# Builds / binaries
*.apk
*.apk.idsig
*.exe
*.pck
# ...menos os pacotes de conteudo, que PRECISAM estar no repositorio: o jogo
# instalado baixa eles por raw.githubusercontent, e o endereco vem daqui.
!packs/*.pck
*.console.exe
build/

# Keystores - NUNCA commitar
*.keystore
android_keystore/

# Android build artifacts
android/build/build/
android/build/.gradle/
android/build/.idea/
android/build/app/build/

# Backups
*.bak
*.bak_*

# Temporários
tmp_*

# UIDs gerados pelo Godot
*.uid

# Credenciais OAuth (nunca versionar)
scripts/google_oauth.gd
scripts/google_oauth.gd.uid

*.apk
!dev/CyronDEV.apk

# APK do app de desenvolvedor: ~200 MB com o audio junto, acima do limite
# de 100 MiB do GitHub. Passou a ser publicado em Releases pelo workflow
# .github/workflows/apk-dev.yml.
dev/*.apk

# Carimbo da versao, escrito pela esteira na hora de montar o APK.
# Nao e versionado: ele descreve UM build, nao o repositorio.
versao_build.json
